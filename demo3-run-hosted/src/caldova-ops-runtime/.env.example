FOUNDRY_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-6.1-terra"
# Optional: use the caldova-ops toolbox locally (azd env get-value TOOLBOX_CALDOVA_OPS_MCP_ENDPOINT).
# Leave unset to use the in-process evidence tools instead.
TOOLBOX_ENDPOINT=""
# Case file: "file" writes to CALDOVA_CASE_DIR (default $HOME/caldova-cases);
# "foundry" uses the Foundry durable state store (hosted runtime only).
CALDOVA_CASE_STORE="file"
CALDOVA_CASE_DIR=""
